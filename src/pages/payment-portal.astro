---
import Base from '../layouts/Base.astro';
const PAYMENT_URL = 'https://REPLACE-WITH-TENANT-PAYMENT-URL';
---
<Base title="Payment Portal | Midgett & Fite Real Estate">
  <h1>Tenant Payment Portal</h1>
  <p>Pay your rent online through our secure payment system.</p>
  <p><a href={PAYMENT_URL}>Go to the payment portal &rarr;</a></p>
  <p style="color:#6b7280;font-size:.85rem;">Replace PAYMENT_URL with the real tenant-payment link from the current Wix site.</p>
</Base>
