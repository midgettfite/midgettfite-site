---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import ListingCard from '../components/ListingCard.astro';
const listings = (await getCollection('listings'))
  .filter((l) => l.data.category === 'commercial-sale')
  .sort((a, b) => (a.data.status === 'sold-leased' ? 1 : 0) - (b.data.status === 'sold-leased' ? 1 : 0) || +b.data.listedDate - +a.data.listedDate);
---
<Base title="Commercial Property for Sale | Midgett & Fite Real Estate">
  <h1>Commercial Property for Sale</h1>
  {listings.length === 0
    ? <p>No current listings in this category. Please check back soon or call (615) 444-3136.</p>
    : <div class="grid">{listings.map((l) => <ListingCard l={l} />)}</div>}

  <section class="resources">
    <h2>Other Resources We Recommend</h2>
    <ul>
      <li><a href="http://www.costar.com/" target="_blank" rel="noopener">CoStar Group</a></li>
      <li><a href="http://www.loopnet.com/" target="_blank" rel="noopener">LoopNet</a></li>
      <li><a href="http://www.ccim.com/" target="_blank" rel="noopener">CCIM</a></li>
    </ul>
  </section>
</Base>
<style>
  .resources { margin-top:32px; }
  .resources ul { list-style:none; padding:0; display:flex; flex-wrap:wrap; gap:10px 22px; }
  .resources a { font-size:.9rem; }
</style>
