---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map((l) => ({ params: { id: l.id }, props: { l } }));
}

const { l } = Astro.props;
const d = l.data;
const isRent = d.category === 'residential-rent' || d.category === 'commercial-rent';
const money = (n: number) => '$' + n.toLocaleString('en-US');
const { Content } = await render(l);
---
<Base title={`${d.address} | Midgett & Fite Real Estate`}>
  <p><a href="javascript:history.back()">&larr; Back to listings</a></p>
  <h1>{d.address}</h1>
  {d.priceUpdated && <span class="badge">Price Update!</span>}
  <p class="price">{money(d.price)}{isRent ? '/mo' : ''}</p>
  <p class="addr">{d.city}, {d.state} {d.zip}</p>
  <p class="specs">
    {d.beds != null && <span>{d.beds} bd&nbsp;&nbsp;</span>}
    {d.baths != null && <span>{d.baths} ba&nbsp;&nbsp;</span>}
    {d.sqft != null && <span>{d.sqft.toLocaleString()} sqft</span>}
  </p>

  {d.photos && d.photos.length > 0 && (
    <div class="grid">{d.photos.map((src: string) => <img src={src} alt={d.address} style="width:100%;border-radius:8px;" />)}</div>
  )}

  <p>{d.description}</p>
  <Content />

  {d.videoUrl && <p><a href={d.videoUrl}>Watch the video tour &rarr;</a></p>}
  <p><a href="/contact">Contact us about this property</a> or call (615) 444-3136.</p>
</Base>
