---
// Staff tool: add / reorder / remove a listing's photos from a phone.
// Photos are shrunk ON THE PHONE (max 2000px, ~300-600 KB) before upload, then the
// whole set is saved to GitHub in ONE commit by worker/index.js (/api/*).
// Not linked from the public site; noindex; every API call needs the staff passcode.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Add Photos · Midgett &amp; Fite</title>
  <style is:global>
    :root { --ink:#22272e; --muted:#6b7280; --accent:#b0413e; --accent-dark:#8f3230; --dark:#2b2b2b; --line:#e5e7eb; --ok:#1f7a3a; --bg:#f6f6f7; --card:#fff; --on-accent:#fff; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color:var(--ink); background:var(--bg); line-height:1.5; }
    header { background:var(--dark); color:var(--on-accent); padding:14px 16px; font-weight:700; font-size:1.1rem; }
    main { max-width:900px; margin:0 auto; padding:16px 16px 120px; }
    .panel { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; margin-bottom:16px; }
    label { display:block; font-weight:600; margin:0 0 6px; }
    input[type=text], input[type=password], select { width:100%; font-size:1rem; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--card); color:var(--ink); }
    .row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .btn { display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:0 18px; font-size:1rem; font-weight:600; border-radius:8px; border:0; cursor:pointer; }
    .btn-primary { background:var(--accent); color:var(--on-accent); }
    .btn-primary:disabled { opacity:.45; cursor:not-allowed; }
    .btn-secondary { background:var(--card); color:var(--ink); border:1px solid var(--line); }
    .hint { color:var(--muted); font-size:.92rem; margin:6px 0 0; }
    .msg { padding:12px 14px; border-radius:8px; margin-bottom:16px; font-weight:600; }
    .msg.err { background:#fdecec; color:var(--accent-dark); }
    .msg.ok { background:#e8f5ec; color:var(--ok); }
    .msg.info { background:#eef2f7; color:var(--ink); }
    .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:12px; margin-top:12px; }
    .tile { background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:hidden; position:relative; }
    .tile.cover { border:3px solid var(--accent); }
    .tile .ph { position:relative; aspect-ratio:4/3; overflow:hidden; min-height:0; background:#ddd; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.85rem; }
    .tile img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
    .tile .badge { position:absolute; top:6px; left:6px; background:var(--accent); color:var(--on-accent); font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:99px; }
    .tile .state { position:absolute; top:6px; right:6px; background:rgba(0,0,0,.65); color:var(--on-accent); font-size:.75rem; padding:2px 8px; border-radius:99px; }
    .tile .state.bad { background:var(--accent-dark); }
    .tile .tools { display:grid; grid-template-columns:repeat(4, 1fr); border-top:1px solid var(--line); }
    .tile .tools button { min-height:44px; border:0; background:var(--card); color:var(--ink); font-size:1.05rem; cursor:pointer; }
    .tile .tools button + button { border-left:1px solid var(--line); }
    .tile .tools button.del { color:var(--accent-dark); }
    .tile .tools button:disabled { color:#c4c4c4; cursor:default; }
    .bar { position:fixed; left:0; right:0; bottom:0; z-index:5; background:var(--card); border-top:1px solid var(--line); padding:12px 16px; display:flex; gap:10px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .hidden { display:none !important; }
    #pick { display:none; }
  </style>
</head>
<body>
  <header>Midgett &amp; Fite · Add Photos</header>
  <main>
    <div id="msg" class="msg hidden" role="status"></div>

    <section id="login" class="panel hidden">
      <label for="key">Staff passcode</label>
      <input id="key" type="password" autocomplete="current-password" />
      <label for="who" style="margin-top:12px">Your first name</label>
      <input id="who" type="text" autocomplete="given-name" />
      <p class="hint">Asked once on this phone, then remembered.</p>
      <div class="row" style="margin-top:12px"><button id="go" class="btn btn-primary">Continue</button></div>
    </section>

    <section id="app" class="hidden">
      <div class="panel">
        <label for="listing">Which listing?</label>
        <select id="listing"><option value="">Loading listings…</option></select>
        <p class="hint">Just made the listing in the editor? It shows up here right away. If not, tap Reload.</p>
        <div class="row" style="margin-top:8px"><button id="reload" class="btn btn-secondary">Reload list</button></div>
      </div>

      <div id="editor" class="panel hidden">
        <div class="row" style="justify-content:space-between">
          <strong id="count"></strong>
          <button id="add" class="btn btn-primary">+ Add photos</button>
          <input id="pick" type="file" accept="image/*" multiple />
        </div>
        <p class="hint">Select as many as you like at once. The first photo is the cover. Use ◀ ▶ to move, ★ to make a photo the cover, ✕ to remove it.</p>
        <div id="grid" class="grid"></div>
      </div>
    </section>
  </main>

  <div id="bar" class="bar hidden">
    <span id="status" class="hint" style="margin:0"></span>
    <div class="row">
      <button id="undo" class="btn btn-secondary">Undo changes</button>
      <button id="save" class="btn btn-primary" disabled>Save photos</button>
    </div>
  </div>

  <script is:inline>
  (() => {
    const MAX_EDGE = 2000, QUALITY = 0.82, PARALLEL = 2;
    const RAW = 'https://raw.githubusercontent.com/midgettfite/midgettfite-site/main/public';
    const $ = (id) => document.getElementById(id);
    const store = {
      get(k) { try { return localStorage.getItem(k) || ''; } catch { return ''; } },
      set(k, v) { try { localStorage.setItem(k, v); } catch {} },
      del(k) { try { localStorage.removeItem(k); } catch {} },
    };

    let key = store.get('mf_upload_key'), who = store.get('mf_upload_who');
    // Personal link: /add-photos#k=<passcode>&who=<name>. Staff just tap it; nothing to type.
    // The part after # never leaves the phone (not sent to the server or logged).
    const fromLink = new URLSearchParams(location.hash.slice(1));
    if (fromLink.get('k')) {
      key = fromLink.get('k'); store.set('mf_upload_key', key);
      if (fromLink.get('who')) { who = fromLink.get('who'); store.set('mf_upload_who', who); }
      history.replaceState(null, '', location.pathname);
    }
    let listings = [], current = null;
    // tiles: { id, path?(existing) , preview?, state:'ok'|'shrinking'|'uploading'|'done'|'error', sha?, err? }
    let tiles = [], nextId = 1;

    function say(text, kind = 'info') {
      const m = $('msg');
      if (!text) { m.className = 'msg hidden'; return; }
      m.className = 'msg ' + kind; m.textContent = text;
      if (kind !== 'info') m.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    async function api(path, opts = {}) {
      const res = await fetch(path, { ...opts, headers: { ...(opts.headers || {}), 'x-upload-key': key } });
      let body = {};
      try { body = await res.json(); } catch {}
      if (res.status === 401) { store.del('mf_upload_key'); key = ''; showLogin(); throw new Error('Wrong passcode. Please enter it again.'); }
      if (!res.ok) throw new Error(body.error || ('Server error ' + res.status));
      return body;
    }

    function showLogin() { $('login').classList.remove('hidden'); $('app').classList.add('hidden'); $('who').value = who; }

    $('go').onclick = async () => {
      key = $('key').value.trim(); who = $('who').value.trim();
      if (!key) return say('Enter the staff passcode.', 'err');
      try { await loadListings(); } catch (e) { return say(e.message, 'err'); }
      store.set('mf_upload_key', key); store.set('mf_upload_who', who);
      $('login').classList.add('hidden'); $('app').classList.remove('hidden'); say('');
    };

    async function loadListings(keepFile) {
      const data = await api('/api/listings');
      listings = data.listings;
      const sel = $('listing');
      const label = { active: 'Available', pending: 'Under contract', 'sold-leased': 'Sold / leased' };
      sel.innerHTML = '<option value="">— choose a listing —</option>' + listings.map((l) =>
        `<option value="${esc(l.file)}">${esc(l.title)} · ${l.photos.length} photo${l.photos.length === 1 ? '' : 's'}${l.status !== 'active' ? ' · ' + (label[l.status] || l.status) : ''}</option>`).join('');
      if (keepFile) { sel.value = keepFile; open(keepFile); }
    }

    function esc(s) { return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

    function dirty() {
      if (!current) return false;
      const now = tiles.map((t) => t.path || 'new');
      return now.length !== current.photos.length || now.some((p, i) => p !== current.photos[i]);
    }

    function open(file) {
      if (dirty() && !confirm('You have unsaved photo changes. Throw them away?')) { $('listing').value = current.file; return; }
      current = listings.find((l) => l.file === file) || null;
      tiles = current ? current.photos.map((p) => ({ id: nextId++, path: p, state: 'ok' })) : [];
      $('editor').classList.toggle('hidden', !current);
      $('bar').classList.toggle('hidden', !current);
      say(''); render();
    }

    $('listing').onchange = (e) => open(e.target.value);
    $('reload').onclick = () => loadListings(current && !dirty() ? current.file : undefined).catch((e) => say(e.message, 'err'));
    $('add').onclick = () => $('pick').click();
    $('undo').onclick = () => { if (current && confirm('Undo all changes since the last save?')) { tiles = current.photos.map((p) => ({ id: nextId++, path: p, state: 'ok' })); render(); } };
    window.addEventListener('beforeunload', (e) => { if (dirty()) { e.preventDefault(); e.returnValue = ''; } });

    function render() {
      const g = $('grid');
      g.innerHTML = '';
      tiles.forEach((t, i) => {
        const d = document.createElement('div');
        d.className = 'tile' + (i === 0 ? ' cover' : '');
        const src = t.preview || t.path || '';
        const stateText = { shrinking: 'Shrinking…', uploading: 'Uploading…', done: 'New', error: 'Failed' }[t.state];
        d.innerHTML = `<div class="ph">${src ? `<img alt="" loading="lazy">` : '…'}</div>`
          + (i === 0 ? '<span class="badge">Cover</span>' : '')
          + (stateText ? `<span class="state${t.state === 'error' ? ' bad' : ''}">${stateText}</span>` : '')
          + `<div class="tools">
               <button aria-label="Move left" ${i === 0 ? 'disabled' : ''} data-a="left">◀</button>
               <button aria-label="Make cover" ${i === 0 ? 'disabled' : ''} data-a="cover">★</button>
               <button aria-label="Move right" ${i === tiles.length - 1 ? 'disabled' : ''} data-a="right">▶</button>
               <button aria-label="Remove" class="del" data-a="del">✕</button>
             </div>`;
        if (src) {
          const img = d.querySelector('img');
          img.src = src;
          // A photo saved a minute ago isn't on the live site until the rebuild finishes.
          if (t.path && !t.preview) img.onerror = () => { if (!img.dataset.raw) { img.dataset.raw = 1; img.src = RAW + t.path; } };
        }
        if (t.state === 'error') d.title = t.err || '';
        d.querySelectorAll('button[data-a]').forEach((b) => b.onclick = () => act(t.id, b.dataset.a));
        g.appendChild(d);
      });
      const busy = tiles.some((t) => t.state === 'shrinking' || t.state === 'uploading');
      const failed = tiles.filter((t) => t.state === 'error').length;
      $('count').textContent = `${tiles.length} photo${tiles.length === 1 ? '' : 's'}`;
      $('save').disabled = busy || failed > 0 || !dirty();
      $('status').textContent = busy ? 'Uploading… you can keep arranging.'
        : failed ? `${failed} photo${failed === 1 ? '' : 's'} failed. Tap ✕ on them, then add again.`
        : dirty() ? 'Not saved yet.' : 'All saved.';
    }

    function act(id, a) {
      const i = tiles.findIndex((t) => t.id === id);
      if (i < 0) return;
      const [t] = tiles.splice(i, 1);
      if (a === 'left') tiles.splice(i - 1, 0, t);
      else if (a === 'right') tiles.splice(i + 1, 0, t);
      else if (a === 'cover') tiles.unshift(t);
      else if (a === 'del') { if (t.preview) URL.revokeObjectURL(t.preview); }
      render();
    }

    $('pick').onchange = (e) => {
      const files = [...e.target.files];
      e.target.value = '';
      const added = files.map((f) => ({ id: nextId++, file: f, state: 'shrinking' }));
      tiles.push(...added);
      render();
      runQueue(added);
    };

    async function runQueue(items) {
      const queue = [...items];
      const worker = async () => {
        while (queue.length) {
          const t = queue.shift();
          if (!tiles.includes(t)) continue; // removed while waiting
          try {
            const blob = await shrink(t.file);
            t.preview = URL.createObjectURL(blob); t.state = 'uploading'; render();
            const b64 = await toBase64(blob);
            const r = await api('/api/blob', { method: 'POST', headers: { 'content-type': 'application/json' }, body: `{"content":"${b64}","encoding":"base64"}` });
            t.sha = r.sha; t.state = 'done'; delete t.file;
          } catch (err) {
            t.state = 'error'; t.err = err.message;
            say(`"${t.file ? t.file.name : 'photo'}" failed: ${err.message}`, 'err');
          }
          render();
        }
      };
      await Promise.all(Array.from({ length: PARALLEL }, worker));
    }

    async function decode(file) {
      if ('createImageBitmap' in window) {
        try { return await createImageBitmap(file, { imageOrientation: 'from-image' }); } catch {}
      }
      return await new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error("this phone can't open that photo format. Try a JPEG.")); };
        img.src = url;
      });
    }

    async function shrink(file) {
      const src = await decode(file);
      const w0 = src.width || src.naturalWidth, h0 = src.height || src.naturalHeight;
      const scale = Math.min(1, MAX_EDGE / Math.max(w0, h0));
      const w = Math.round(w0 * scale), h = Math.round(h0 * scale);
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h); // PNG transparency -> white, not black
      ctx.drawImage(src, 0, 0, w, h);
      if (src.close) src.close();
      const blob = await new Promise((r) => c.toBlob(r, 'image/jpeg', QUALITY));
      if (!blob) throw new Error('could not shrink this photo.');
      return blob;
    }

    function toBase64(blob) {
      return new Promise((resolve, reject) => {
        const fr = new FileReader();
        fr.onload = () => resolve(String(fr.result).split(',')[1]);
        fr.onerror = () => reject(new Error('could not read the shrunk photo.'));
        fr.readAsDataURL(blob);
      });
    }

    $('save').onclick = async () => {
      if (!current) return;
      $('save').disabled = true; $('status').textContent = 'Saving…';
      try {
        const r = await api('/api/save', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ file: current.file, by: who, photos: tiles.map((t) => t.path || { sha: t.sha }) }),
        });
        current.photos = r.photos;
        // Keep the phone's own thumbnail for just-saved photos: the live site
        // doesn't have them until the rebuild (~2 min) finishes.
        tiles = r.photos.map((p, i) => ({ id: nextId++, path: p, state: 'ok', preview: tiles[i] ? tiles[i].preview : undefined }));
        render();
        say(`Saved ${r.photos.length} photo${r.photos.length === 1 ? '' : 's'}. The website shows them in about 2 minutes.`, 'ok');
        const file = current.file; // refresh the photo counts in the menu without redrawing the tiles
        loadListings().then(() => { $('listing').value = file; current = listings.find((l) => l.file === file) || current; }).catch(() => {});
      } catch (e) {
        say('Not saved: ' + e.message, 'err'); render();
      }
    };

    if (key) { $('app').classList.remove('hidden'); loadListings().catch((e) => say(e.message, 'err')); }
    else showLogin();
  })();
  </script>
</body>
</html>
