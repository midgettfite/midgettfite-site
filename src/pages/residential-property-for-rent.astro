---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import ListingCard from '../components/ListingCard.astro';
const listings = (await getCollection('listings'))
  .filter((l) => l.data.category === 'residential-rent' && l.data.status !== 'sold-leased')
  .sort((a, b) => +b.data.listedDate - +a.data.listedDate);
---
<Base title="Residential Property for Rent | Midgett & Fite Real Estate">
  <h1>Residential Property for Rent</h1>
  {listings.length === 0
    ? <p>No current listings in this category. Please check back soon or call (615) 444-3136.</p>
    : <div class="grid">{listings.map((l) => <ListingCard l={l} />)}</div>}
</Base>
