---
import Base from '../layouts/Base.astro';
// NOTE: The Online Application is an external JotForm (stays as-is).
// The other 5 documents are currently hosted on Wix and MUST be downloaded
// and placed in /public/forms/ before Wix is decommissioned, or these links break.
const forms = [
  { label: 'Online Application', href: 'https://form.jotform.com/233547002774152', external: true },
  { label: 'Printable Application (PDF)', href: '/forms/printable-application.pdf', external: false },
  { label: 'Move-in Checklist', href: '/forms/move-in-checklist.docx', external: false },
  { label: 'Move-out Checklist', href: '/forms/move-out-checklist.docx', external: false },
  { label: 'Visitor Form (English & Spanish)', href: '/forms/visitor-notice.doc', external: false },
  { label: 'Home Maintenance Tips (PDF)', href: '/forms/home-maintenance-tips.pdf', external: false },
];
---
<Base title="Helpful Forms | Midgett & Fite Real Estate" description="Applications, checklists, and helpful forms for Midgett & Fite property management tenants.">
  <h1>Helpful Forms</h1>
  <p>Midgett &amp; Fite seeks to assist our property management tenants in a variety of ways. Below are links to several forms and helpful tips for our tenants and future tenants:</p>
  <ul class="forms">
    {forms.map((f) => (
      <li><a href={f.href} target={f.external ? '_blank' : undefined} rel={f.external ? 'noopener' : undefined}>{f.label}</a></li>
    ))}
  </ul>
</Base>
<style>
  .forms { list-style:none; padding:0; margin:20px 0; display:grid; gap:10px; max-width:420px; }
  .forms li a { display:block; padding:12px 16px; border:1px solid #e5e7eb; border-radius:8px; text-decoration:none; color:#1f2933; font-weight:600; }
  .forms li a:hover { border-color:#b0413e; color:#b0413e; }
</style>
